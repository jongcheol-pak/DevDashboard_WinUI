<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DevDashboard.Presentation.Views.Dialogs.GitStatusDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DevDashboard.Presentation.Views.Dialogs"
    xmlns:models="using:DevDashboard.Domain.ValueObjects"
    CornerRadius="8"
    Opened="OnOpened">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">700</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">700</x:Double>

        <!-- 팔레트 색은 ThemeDictionaries 안에 있어 코드에서 Application.Current.Resources로 못 꺼낸다.
             DashboardView 선례대로 뷰 자신의 리소스에 브러시로 별칭을 만들어 코드에서 조회한다. -->
        <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource AppHoverFillColor}" />
        <SolidColorBrush x:Key="RowRestBrush" Color="Transparent" />
        <SolidColorBrush x:Key="Avatar1Brush" Color="{ThemeResource AppInfoColor}" />
        <SolidColorBrush x:Key="Avatar2Brush" Color="{ThemeResource AppSuccessColor}" />
        <SolidColorBrush x:Key="Avatar3Brush" Color="{ThemeResource AppWarningColor}" />
        <SolidColorBrush x:Key="Avatar4Brush" Color="{ThemeResource AppAccentColor}" />
    </ContentDialog.Resources>

    <Grid>
        <!-- 로딩 중 -->
        <StackPanel
            x:Name="LoadingPanel"
            Orientation="Horizontal"
            Spacing="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Padding="0,24">
            <ProgressRing IsActive="True" Width="24" Height="24" />
            <TextBlock x:Uid="GitLoadingText" VerticalAlignment="Center" />
        </StackPanel>

        <!-- 에러 -->
        <InfoBar
            x:Name="ErrorBar"
            x:Uid="GitErrorBar"
            VerticalAlignment="Top"
            IsOpen="False"
            Severity="Error"
            IsClosable="False" />

        <!-- ===== 목록 뷰 ===== -->
        <Grid x:Name="ListArea" Visibility="Collapsed" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 브랜치 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xF1D3;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                          Foreground="{ThemeResource AppTextTertiaryBrush}" />
                <TextBlock x:Name="BranchText"
                           Style="{StaticResource BodyStrongTextBlockStyle}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Rectangle Grid.Row="1" Style="{StaticResource SeparatorStyle}" />

            <!-- 커밋 목록 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,12,0">
                    <ItemsControl x:Name="CommitList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:GitCommit">
                                <!-- 기준 이미지는 카드가 아니라 하단 구분선으로 나뉜 행이다 -->
                                <Border
                                    Background="{StaticResource RowRestBrush}"
                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,11"
                                    Tapped="CommitRow_Tapped"
                                    PointerEntered="CommitRow_PointerEntered"
                                    PointerExited="CommitRow_PointerExited"
                                    Tag="{x:Bind}">
                                    <StackPanel Spacing="5">
                                        <!-- 제목(메시지 첫 줄) -->
                                        <TextBlock
                                            Text="{x:Bind Subject}"
                                            FontSize="13"
                                            Foreground="{ThemeResource AppTextPrimaryBrush}"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />

                                        <!-- 아바타 · 작성자 · 상대시간 · 단축 해시 -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                <Ellipse Fill="{x:Bind local:GitStatusDialog.AvatarBrush(AuthorEmail)}" />
                                                <TextBlock
                                                    Text="{x:Bind local:GitStatusDialog.AvatarInitial(AuthorName)}"
                                                    FontSize="9"
                                                    Foreground="{ThemeResource AppTextPrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock
                                                Text="{x:Bind AuthorName}"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="·"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind local:GitStatusDialog.RelativeTime(Date)}"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="·"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="{x:Bind ShortHash}"
                                                FontFamily="Consolas"
                                                FontSize="11.5"
                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 커밋 없음 -->
                    <TextBlock
                        x:Name="NoCommitsText"
                        x:Uid="NoCommitsText"
                        Foreground="{ThemeResource AppTextTertiaryBrush}"
                        HorizontalAlignment="Center"
                        Padding="0,24"
                        Visibility="Collapsed" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ===== 상세 뷰 ===== -->
        <Grid x:Name="DetailArea" Visibility="Collapsed" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 뒤로 가기 (라벨은 아이콘과 함께 놓아야 해서 코드비하인드가 채운다 — x:Uid 미사용) -->
            <Button Grid.Row="0"
                    Height="32" CornerRadius="8" Padding="12,0"
                    HorizontalAlignment="Left"
                    Click="BackToList_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE76B;" FontSize="12" />
                    <TextBlock x:Name="BackText" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- 작성자 헤더 -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top">
                    <Ellipse x:Name="DetailAvatar" />
                    <TextBlock x:Name="DetailAvatarInitial"
                               FontSize="16"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailAuthorText"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="DetailMetaText"
                               FontSize="12"
                               Foreground="{ThemeResource AppTextTertiaryBrush}"
                               IsTextSelectionEnabled="True" />
                </StackPanel>
            </Grid>

            <!-- 커밋 메시지 전문 -->
            <Border Grid.Row="2"
                    Background="{ThemeResource AppInputBrush}"
                    CornerRadius="8"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailMessageText"
                               FontFamily="Consolas"
                               FontSize="13"
                               LineHeight="20"
                               Foreground="{ThemeResource AppTextPrimaryBrush}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>

</ContentDialog>
