<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DevDashboard.Presentation.Views.Dialogs.ProjectMemoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    CornerRadius="8">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">680</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">680</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- placeholder는 접미 없는 resw 키라 x:Uid로 붙이면 빈 문자열이 된다 → 코드비하인드에서 설정 -->
        <TextBox
            x:Name="MemoBox"
            Grid.Row="0"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            MinHeight="320"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <!-- 메모가 있을 때만 노출. 저장·취소는 ContentDialog 기본 버튼이 담당하므로 여기엔 삭제만 둔다 -->
        <Button
            x:Name="DeleteButton"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Background="{ThemeResource AppAccentSoftBrush}"
            BorderBrush="{ThemeResource AppAccentSoftBrush}"
            Foreground="{ThemeResource AppDangerBrush}"
            Visibility="Collapsed"
            Click="Delete_Click" />
    </Grid>

</ContentDialog>
