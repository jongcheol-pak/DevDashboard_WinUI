<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="DevDashboard.Presentation.Views.Dialogs.HistoryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DevDashboard.Presentation.ViewModels"
    xmlns:local="using:DevDashboard.Presentation.Views.Dialogs"
    xmlns:helpers="using:DevDashboard.Presentation.Helpers"
    CornerRadius="8"
    >

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
        <x:Double x:Key="ContentDialogMinHeight">680</x:Double>

        <!-- 행 안의 pill 2종(유형·프로젝트)이 같은 치수를 쓰므로 로컬 스타일로 묶는다 -->
        <Style x:Key="HistoryPillStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 헤더: 제목 + 프로젝트 pill + 총 건수 (목록·폼 공용, 시안 :756~760) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock
                x:Uid="HistoryDialog_Header"
                FontSize="19" FontWeight="Bold"
                VerticalAlignment="Center" />
            <Border Background="{ThemeResource AppBorderBrush}" CornerRadius="7" Padding="10,4" VerticalAlignment="Center">
                <TextBlock
                    Text="{x:Bind Vm.ProjectName}"
                    FontSize="12"
                    Foreground="{ThemeResource AppTextSecondaryBrush}" />
            </Border>
            <TextBlock
                Text="{x:Bind local:HistoryDialog.CountText(Vm.FilteredCount), Mode=OneWay}"
                FontSize="12"
                Foreground="{ThemeResource AppTextTertiaryBrush}"
                VerticalAlignment="Center" />
        </StackPanel>

        <!-- 목록 화면 (검색행 + 인라인 추가 폼 + 기록 목록 + 페이지네이션) -->
        <Grid Grid.Row="1" x:Name="ListArea" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 검색 + 새 기록 + 내보내기 -->
            <Grid Grid.Row="0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    helpers:AutoSuggestBoxHelper.MaxLength="50"
                    x:Uid="HistorySearchBox"
                    Grid.Column="0"
                    Height="38"
                    QueryIcon="Find"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    x:Uid="AddHistoryBtn"
                    Grid.Column="1"
                    Height="38"
                    CornerRadius="9"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ToggleAddPanel_Click" />
                <Button
                    Grid.Column="2"
                    Width="38" Height="38"
                    CornerRadius="9"
                    Padding="0"
                    Click="Export_Click">
                    <FontIcon Glyph="&#xE896;" FontSize="14"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch">
                <StackPanel Spacing="20" Margin="0,0,12,12">

                    <!-- 기록 목록 -->
                    <ItemsControl x:Name="GroupList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryDateGroup">
                                <StackPanel Spacing="8">
                                    <!-- 날짜 헤더: 날짜 + 건수 + 남는 폭을 채우는 구분선 (시안 :778~782) -->
                                    <Grid ColumnSpacing="9" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{x:Bind DateText}"
                                            FontFamily="Consolas"
                                            FontSize="12.5" FontWeight="Bold"
                                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind CountText}"
                                            FontSize="11"
                                            Foreground="{ThemeResource AppTextTertiaryBrush}"
                                            VerticalAlignment="Center" />
                                        <Rectangle
                                            Grid.Column="2"
                                            Height="1"
                                            Fill="{ThemeResource AppBorderBrush}"
                                            VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- 항목 목록 -->
                                    <ItemsControl ItemsSource="{x:Bind Entries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:HistoryEntryViewModel">
                                                <Border
                                                    Background="{ThemeResource AppCardAltBrush}"
                                                    BorderBrush="{ThemeResource AppBorderBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,8"
                                                    CornerRadius="10"
                                                    Tapped="EntryBorder_Tapped"
                                                    PointerEntered="EntryBorder_PointerEntered"
                                                    PointerExited="EntryBorder_PointerExited"
                                                    Tag="{x:Bind}">
                                                    <StackPanel>
                                                        <!-- 항상 표시: 시각 + 제목 + 유형 배지 + 프로젝트 pill + 편집·삭제 -->
                                                        <Grid Padding="14,12" ColumnSpacing="11">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon
                                                                Grid.Column="0"
                                                                Glyph="{x:Bind ExpandChevron, Mode=OneWay}"
                                                                FontSize="11"
                                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                                VerticalAlignment="Center" />
                                                            <TextBlock
                                                                Grid.Column="1"
                                                                Text="{x:Bind TimeText}"
                                                                FontFamily="Consolas"
                                                                FontSize="11.5"
                                                                Foreground="{ThemeResource AppTextTertiaryBrush}"
                                                                VerticalAlignment="Center" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                Text="{x:Bind Title}"
                                                                FontSize="13.5"
                                                                TextTrimming="CharacterEllipsis"
                                                                TextWrapping="NoWrap"
                                                                VerticalAlignment="Center" />
                                                            <!-- 유형 배지 (유형이 지정된 경우만) — 색은 코드비하인드 static이 직접 반환 -->
                                                            <Border
                                                                Grid.Column="3"
                                                                Style="{StaticResource HistoryPillStyle}"
                                                                Background="{x:Bind local:HistoryDialog.KindBackBrush(Kind)}"
                                                                Visibility="{x:Bind KindVisibility}">
                                                                <TextBlock
                                                                    Text="{x:Bind Kind}"
                                                                    FontSize="11" FontWeight="Bold"
                                                                    Foreground="{x:Bind local:HistoryDialog.KindBrush(Kind)}" />
                                                            </Border>
                                                            <Border
                                                                Grid.Column="4"
                                                                Style="{StaticResource HistoryPillStyle}"
                                                                Background="{ThemeResource AppHoverFillBrush}">
                                                                <TextBlock
                                                                    Text="{x:Bind ProjectName}"
                                                                    FontSize="11.5"
                                                                    Foreground="{ThemeResource AppTextTertiaryBrush}" />
                                                            </Border>
                                                            <Button
                                                                Grid.Column="5"
                                                                Width="27" Height="27"
                                                                Padding="0"
                                                                CornerRadius="7"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="{x:Bind EditTooltip}"
                                                                Tag="{x:Bind}"
                                                                Tapped="EditBtn_Tapped"
                                                                Click="EditEntry_Click">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="12" />
                                                            </Button>
                                                            <Button
                                                                Grid.Column="6"
                                                                Width="27" Height="27"
                                                                Padding="0"
                                                                CornerRadius="7"
                                                                VerticalAlignment="Center"
                                                                ToolTipService.ToolTip="{x:Bind DeleteTooltip}"
                                                                Tag="{x:Bind}"
                                                                Tapped="DeleteBtn_Tapped"
                                                                Click="DeleteEntry_Click">
                                                                <FontIcon Glyph="&#xE74D;" FontSize="12" />
                                                            </Button>
                                                        </Grid>
                                                        <!-- 펼쳐진 경우: 상단 구분선 + 좌측 들여쓰기 상세 (시안 :800~802) -->
                                                        <Border
                                                            BorderBrush="{ThemeResource AppBorderBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                                                            <TextBlock
                                                                Text="{x:Bind Description}"
                                                                Margin="50,11,14,13"
                                                                FontSize="12.5"
                                                                LineHeight="21"
                                                                Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{x:Bind DescriptionVisibility, Mode=OneWay}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 빈 상태 — 문구는 검색 여부에 따라 코드비하인드가 설정한다 -->
                    <TextBlock
                        x:Name="EmptyText"
                        Foreground="{ThemeResource AppTextMutedBrush}"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        Padding="0,60"
                        Visibility="Collapsed" />

                </StackPanel>
            </ScrollViewer>

            <!-- 페이지 컨트롤 (좌측 페이지 정보 + 가로 중앙 이전·번호·다음) -->
            <Border
                Grid.Row="3"
                BorderBrush="{ThemeResource AppBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,14,0,0"
                Visibility="{x:Bind Vm.HasEntries, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <Grid>
                    <TextBlock
                        Text="{x:Bind Vm.PageInfoText, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{ThemeResource AppTextTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <Button Width="32" Height="32" Padding="0" CornerRadius="8"
                                Command="{x:Bind Vm.PrevPageCommand}" IsEnabled="{x:Bind Vm.CanPrevPage, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Vm.PrevPageTooltip}">
                            <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" CornerRadius="8"
                                Command="{x:Bind Vm.NextPageCommand}" IsEnabled="{x:Bind Vm.CanNextPage, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind Vm.NextPageTooltip}">
                            <FontIcon Glyph="&#xE76C;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 새 기록 / 기록 수정 폼 — 목록을 대체한다(시안 :829~875). 중첩 다이얼로그를 쓰지 않는다 -->
        <Grid Grid.Row="1" x:Name="FormArea" Visibility="Collapsed" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 뒤로가기 + 폼 제목 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Button x:Uid="HistoryForm_Back" Height="32" CornerRadius="8" Padding="12,0" Click="BackToList_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" />
                        <TextBlock x:Name="BackText" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FormHeaderText" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Margin="0,0,12,0">
                    <!-- 제목 (필수) -->
                    <StackPanel Spacing="7">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Uid="HistoryForm_TitleLabel" Style="{StaticResource InputLabelStyle}" />
                            <TextBlock Text="*" Foreground="{ThemeResource AppAccentBrush}" FontSize="12.5" />
                        </StackPanel>
                        <StackPanel>
                            <TextBox
                                x:Name="FormTitleBox"
                                x:Uid="HistoryForm_TitleBox"
                                Height="38"
                                MaxLength="200"
                                TextChanged="FormTitle_TextChanged" />
                            <!-- 필수 항목 표시 — 시안은 입력 여부와 무관하게 항상 액센트 밑줄을 둔다 -->
                            <Rectangle Height="2" Fill="{ThemeResource AppAccentBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 날짜 · 시간 · 유형 (시안은 2열 그리드 안에 함께 놓는다) -->
                    <Grid ColumnSpacing="14" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="7">
                            <TextBlock x:Uid="HistoryForm_DateLabel" Style="{StaticResource InputLabelStyle}" />
                            <CalendarDatePicker x:Name="FormDatePicker" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="7">
                            <TextBlock x:Uid="HistoryForm_TimeLabel" Style="{StaticResource InputLabelStyle}" />
                            <TimePicker x:Name="FormTimePicker" HorizontalAlignment="Stretch" ClockIdentifier="24HourClock" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="7">
                            <TextBlock x:Uid="HistoryForm_KindLabel" Style="{StaticResource InputLabelStyle}" />
                            <ComboBox x:Name="FormKindCombo" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <!-- 내용 -->
                    <StackPanel Spacing="7">
                        <TextBlock x:Uid="HistoryForm_DetailLabel" Style="{StaticResource InputLabelStyle}" />
                        <TextBox
                            x:Name="FormDetailBox"
                            x:Uid="HistoryForm_DetailBox"
                            AcceptsReturn="True"
                            MinHeight="120"
                            TextWrapping="Wrap"
                            MaxLength="1000"
                            helpers:TextBoxHelper.MaxLines="20"
                            ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 저장 · 취소 (제목이 비면 저장 비활성 — 시안 :1519) -->
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="FormSaveButton"
                    x:Uid="Btn_Save"
                    Grid.Column="0"
                    Height="42"
                    CornerRadius="10"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SaveForm_Click" />
                <Button
                    x:Uid="Btn_Cancel"
                    Grid.Column="1"
                    Height="42"
                    CornerRadius="10"
                    HorizontalAlignment="Stretch"
                    Click="BackToList_Click" />
            </Grid>
        </Grid>
    </Grid>

</ContentDialog>
